{
  "name": "border-hopper",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@politecarrot/capacitor-unity-ads": "github:Polite-Carrot/polite-carrot-unity-ads#96f31aa21ee8cd5e966797b37c438540c092f444",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.24",
    "expo-haptics": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "~19.2.2",
    "@types/topojson-client": "^3.1.5",
    "country-flag-icons": "^1.6.20",
    "country-json": "^2.3.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "i18n-iso-countries": "^7.14.0",
    "polylabel": "^2.1.0",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:data": "tsx scripts/build-country-data.ts",
    "build:flags": "tsx scripts/build-flags.ts",
    "build:web": "expo export -p web && node scripts/finish-web-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:campaign": "tsx scripts/build-campaign.ts",
    "sync:native": "npm run build:web && npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "assets:native": "capacitor-assets generate --ios --android --assetPath resources"
  },
  "private": true,
  "description": "A geography game about crossing the world one land border at a time"
}
